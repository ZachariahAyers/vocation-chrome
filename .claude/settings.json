{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
            "Bash(npm ci)",
            "Bash(npm run check)",
            "Bash(npm run typecheck)",
            "Bash(npm run lint)",
            "Bash(npm run format)",
            "Bash(npm run format:check)",
            "Bash(npm run build)",
            "Bash(npm run icons)",
            "Bash(npm test)",
            "Bash(npx vitest run *)",
            "Bash(git status)",
            "Bash(git diff *)",
            "Bash(git log *)"
        ]
    }
}
