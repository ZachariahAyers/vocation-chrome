{
    "manifest_version": 3,
    "name": "Vocation",
    "version": "2.0.0",
    "description": "Draft cover letters and outreach messages from your profile, and work through your job boards each day.",
    "homepage_url": "https://github.com/ZachariahAyers/vocation-chrome",
    "icons": {
        "16": "icons/16.png",
        "48": "icons/48.png",
        "128": "icons/128.png"
    },
    "action": {
        "default_title": "Vocation",
        "default_icon": {
            "19": "icons/19.png",
            "38": "icons/38.png"
        }
    },
    "permissions": ["storage", "offscreen", "clipboardWrite"],
    "background": {
        "service_worker": "service-worker.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["content.css"],
            "matches": ["<all_urls>"]
        }
    ]
}
