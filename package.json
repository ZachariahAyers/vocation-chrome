{
    "name": "vocation-chrome",
    "version": "2.0.0",
    "private": true,
    "description": "Chrome extension that drafts cover letters and outreach messages from your profile and tracks your daily job-board rounds.",
    "type": "module",
    "scripts": {
        "dev": "vite build --mode content --watch",
        "build": "vite build --mode content",
        "typecheck": "vue-tsc --build",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
    },
    "dependencies": {
        "vue": "^3.5.44"
    },
    "devDependencies": {
        "@types/chrome": "^0.3.5",
        "@types/node": "^24.19.2",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.5.1",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.11.1",
        "happy-dom": "^21.0.3",
        "prettier": "^3.9.10",
        "sass": "^1.105.2",
        "typescript": "~6.0.3",
        "vite": "^8.3.4",
        "vitest": "^5.0.5",
        "vue-tsc": "^3.3.13"
    },
    "author": {
        "name": "Zachariah Ayers",
        "url": "https://ayers.repair"
    },
    "repository": "github:ZachariahAyers/vocation-chrome",
    "license": "Apache-2.0",
    "engines": {
        "node": ">=22.18.0"
    }
}
